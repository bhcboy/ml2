import pandas as pd 
from sklearn.tree import DecisionTreeClassifier, plot_tree 
import matplotlib.pyplot as plt 
import seaborn as sns 
# Step 1: Create Weather Dataset 
data = { 
    'Outlook': ['Sunny', 'Sunny', 'Overcast', 'Rain', 'Rain', 'Rain', 'Overcast', 
                'Sunny', 'Sunny', 'Rain', 'Sunny', 'Overcast', 'Overcast', 'Rain'], 
    'Temperature': ['Hot', 'Hot', 'Hot', 'Mild', 'Cool', 'Cool', 'Cool', 
                    'Mild', 'Cool', 'Mild', 'Mild', 'Mild', 'Hot', 'Mild'], 
    'Humidity': ['High', 'High', 'High', 'High', 'Normal', 'Normal', 'Normal', 
                 'High', 'Normal', 'Normal', 'Normal', 'High', 'Normal', 'High'], 
    'Wind': ['Weak', 'Strong', 'Weak', 'Weak', 'Weak', 'Strong', 'Strong', 
             'Weak', 'Weak', 'Weak', 'Strong', 'Strong', 'Weak', 'Strong'], 
    'Play': ['No', 'No', 'Yes', 'Yes', 'Yes', 'No', 'Yes', 
             'No', 'Yes', 'Yes', 'Yes', 'Yes', 'Yes', 'No'] 
} 
df = pd.DataFrame(data) 
print("Weather Dataset:\n", df) 
# Step 2: Encode Categorical Data 
from sklearn.preprocessing import LabelEncoder 
le = LabelEncoder() 
for column in df.columns: 
    df[column] = le.fit_transform(df[column])
# Features and target 
X = df[['Outlook', 'Temperature', 'Humidity', 'Wind']] 
y = df['Play'] 
# Step 3: Train Decision Tree 
clf = DecisionTreeClassifier(criterion='entropy', random_state=0) 
clf.fit(X, y) 
# Step 4: Visualize Decision Tree 
plt.figure(figsize=(10,6)) 
plot_tree(clf, feature_names=['Outlook','Temperature','Humidity','Wind'],  
class_names=['No','Yes'], filled=True, rounded=True) 
plt.show() 
# Step 5: Data Visualization 
# Count plot of Play decisions 
plt.figure(figsize=(6,4)) 
sns.countplot(x='Play', data=pd.DataFrame(data)) 
plt.title("Play Decision Distribution") 
plt.show() 
# Outlook vs Play 
plt.figure(figsize=(6,4)) 
sns.countplot(x='Outlook', hue='Play', data=pd.DataFrame(data)) 
plt.title("Outlook vs Play") 
plt.show() 
